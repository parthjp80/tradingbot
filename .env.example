# Copy this file to .env and fill in real values. .env is gitignored.

# "live" = real yfinance data (default, needs outbound internet -- fine on TrueNAS)
# "synthetic" = offline deterministic test data, no network required
BOT_DATA_FEED=live

# How often the orchestrator runs during market hours
POLL_INTERVAL_MINUTES=30

# --- Broker backend ---
# "internal_simulator" (default): the built-in paper-trading engine, no
#   external account needed.
# "alpaca_paper": routes real orders to your Alpaca PAPER account. Requires
#   ALPACA_API_KEY/ALPACA_SECRET_KEY below and Level 3 options approval on
#   that account (needed for multi-leg spreads/iron condors). Alpaca does
#   not support futures -- MES signals are skipped automatically when this
#   is active. See bot/alpaca_broker.py for details and caveats.
BOT_BROKER_BACKEND=internal_simulator

# Get these from your Alpaca paper account dashboard (app.alpaca.markets ->
# Paper Trading -> API Keys). These are PAPER keys, not live-account keys --
# the bot hardcodes paper=True regardless, but don't paste live keys here.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# --- Prediction-market macro signal (Kalshi) ---
# "true" pulls a small set of Kalshi prediction-market series (recession
# odds, Fed rate cut odds) each cycle and uses them for two things:
#  (1) cuts position size further when recession odds are elevated
#      (independent of the technical CRISIS regime)
#  (2) a small directional confidence tilt on TRENDING-regime signals
# No API key needed -- Kalshi's market-data reads are public. See
# bot/prediction_markets.py for important caveats on how this is
# interpreted (it's macro-only, not a per-stock signal, despite affecting
# stock selection via the scanner's ranking).
BOT_PREDICTION_MARKETS_ENABLED=false

# --- Not yet wired in: reserved for the live tastytrade/DXLink integration ---
# Reuse the same OAuth2 client you already set up for trading-reporter.
# TASTYTRADE_CLIENT_ID=
# TASTYTRADE_CLIENT_SECRET=
# TASTYTRADE_REFRESH_TOKEN=
# TASTYTRADE_ACCOUNT_NUMBER=

# --- Optional: email cycle summaries, same SMTP pattern as market-news ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=info@nextgenhealthymart.com
