FROM python:3.11-slim

WORKDIR /app

# optimizer.py's own import chain (bot.config, bot.models, bot.journal,
# bot.tuned_overrides, bot.tuning_limits) is pure stdlib -- no
# `pip install -r requirements.txt` needed here, unlike the main
# Dockerfile. Keeping this image to just git + gh CLI (for autotune.sh's
# clone/branch/push/PR steps) and nothing else the always-on production
# image needs (yfinance, alpaca-py, apscheduler, etc.).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

COPY optimizer.py autotune.sh ./
COPY bot/ ./bot/
COPY config/ ./config/
RUN chmod +x autotune.sh

ENV PYTHONUNBUFFERED=1
ENV TZ=America/New_York

CMD ["./autotune.sh"]
