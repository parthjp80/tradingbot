# Non-secret config, loaded via envFrom in deployment.yaml. See
# .env.example in the repo root for full descriptions of each var.

# "live" = real yfinance data (needs outbound internet, fine on the cluster)
BOT_DATA_FEED=live

# How often the orchestrator runs during market hours
POLL_INTERVAL_MINUTES=30

# "internal_simulator" (default, no external account needed) or
# "alpaca_paper" (requires ALPACA_API_KEY/ALPACA_SECRET_KEY in secret.env
# and Level 3 options approval on that account)
BOT_BROKER_BACKEND=alpaca_paper

# Kalshi prediction-market macro overlay -- off by default, no API key needed
BOT_PREDICTION_MARKETS_ENABLED=false
